# ============================================================
#  Multimodal RAG — backend environment configuration
#  Copy this file to `.env` and fill in the values.
#  NEVER commit your real `.env` (it is in .gitignore).
# ============================================================

# ---- LLM provider -------------------------------------------------
# Which multimodal LLM to use for answer generation.
# Supported: "gemini" (default) | "openai"
LLM_PROVIDER=gemini

# API key for the selected provider.
LLM_API_KEY=

# Model name (must be a *multimodal* / vision model).
#   gemini  ->  gemini-3.6-flash   (fast, free tier) or gemini-3.6-pro
#   openai  ->  gpt-4o-mini        or gpt-4o
LLM_MODEL=gemini-3.6-flash

# ---- Embedding models --------------------------------------------
# Text embedding model (Sentence-Transformers name or local path).
# Leave UNSET to auto-use the legal fine-tuned model (./app/models/legal-bge-finetuned)
# once you've run scripts/finetune_legal_embeddings.py, falling back to the base
# BAAI/bge-small-en-v1.5 model otherwise. See app/config.py.
# TEXT_EMBEDDING_MODEL=./app/models/legal-bge-finetuned
# Image + cross-modal text embedding model (CLIP).
IMAGE_EMBEDDING_MODEL=clip-ViT-B-32

# ---- Storage paths -----------------------------------------------
VECTOR_DB_PATH=./vector_store
DATA_PATH=./data

# ---- Retrieval tuning --------------------------------------------
TOP_K_TEXT=5
TOP_K_VISUAL=3
# Weights for the combined multimodal relevance score
# (text_score * ALPHA + visual_score * BETA). See README section 10.
SCORE_ALPHA=0.6
SCORE_BETA=0.4

# ---- Server ------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Limits ------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_PAGES=200
