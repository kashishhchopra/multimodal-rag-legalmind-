# --- LLM providers (swap-able; used via src/config.py) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-sonnet-5

# --- Embeddings ---
EMBEDDING_PROVIDER=openai       # openai | bge
EMBEDDING_MODEL=text-embedding-3-large

# --- Vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=legalmind_chunks

# --- Task queue ---
REDIS_URL=redis://localhost:6379/0

# --- Observability ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=legalmind

# --- OCR / vision fallback ---
VISION_MODEL=claude-sonnet-5
OCR_ENGINE=tesseract             # tesseract | paddleocr

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
